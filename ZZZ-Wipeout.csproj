<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ZZZ-Wipeout</AssemblyName>
    <RootNamespace>ZzzWipeout</RootNamespace>
    <ApplicationIcon>ZZZ-Wipeout.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.2</Version>
    <Product>ZZZ 와이프아웃 캡처</Product>
    <Description>젠레스 존 제로 WIPEOUT 연출 자동 캡처</Description>
    <Copyright>Copyright (c) 2026 lazyman1414</Copyright>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ZZZ-Wipeout.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
